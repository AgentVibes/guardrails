{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "extends": ["./configs/biome.json"],
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "!**/dist",
      "!**/node_modules",
      "!**/*.tsbuildinfo",
      "!pnpm-lock.yaml",
      "!rules/__fixtures__"
    ]
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
