{
  "name": "@agentvibes/guardrails",
  "version": "0.4.5",
  "description": "Verification toolkit that makes agents write simple code: ast-grep rule canon, diff ratchet, biome/tsconfig presets, one CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentVibes/guardrails.git"
  },
  "type": "module",
  "bin": {
    "guardrails": "dist/cli.js"
  },
  "exports": {
    "./biome": "./configs/biome.json",
    "./tsconfig": "./configs/tsconfig.base.json",
    "./sgconfig": "./sgconfig.yml",
    "./package.json": "./package.json",
    "./plugin": "./dist/pluginApi.js",
    "./overrides": "./dist/overrides.js",
    "./wiring": "./dist/wiring.js",
    "./record": "./dist/record/index.js"
  },
  "files": [
    "dist",
    "rules",
    "structure",
    "candidates",
    "configs",
    "sgconfig.yml",
    "mise.toml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "guardrails": "node dist/cli.js",
    "lint": "biome check . && pnpm -s guardrails verify-diff && pnpm -s guardrails doctor",
    "format": "biome check --write .",
    "test:rules": "node dist/testRules.js",
    "test:gate": "node dist/gateRed.js",
    "check": "pnpm build && pnpm lint && pnpm test:rules && pnpm test:twins && pnpm test:repo-rules && pnpm test:preset && pnpm test:overrides && pnpm test:wiring && pnpm test:record && pnpm test:snapshot && pnpm test:time && pnpm test:tasks && pnpm test:gate && pnpm test:sibling-clone && pnpm test:metrics && pnpm test:cli-args && pnpm test:init && pnpm test:severity && pnpm test:screens && pnpm test:jsx-suppress && pnpm test:hooks && pnpm test:claude-hooks && pnpm test:iterate && pnpm test:rename-diff && pnpm test:leaks && pnpm test:pipe && pnpm test:file-sloc && pnpm test:rust-language && pnpm test:rust-scan && pnpm test:rust-config && pnpm test:schema-migration && pnpm test:rust-cli && pnpm leaks",
    "test:metrics": "node dist/metricsCycle.js",
    "leaks": "node dist/cli.js leaks .",
    "test:leaks": "node dist/leaksRed.js",
    "test:pipe": "node dist/pipeOutputTest.js",
    "test:file-sloc": "node dist/fileSlocTest.js",
    "test:init": "node dist/initTest.js",
    "test:severity": "node dist/severityTest.js",
    "test:hooks": "node dist/hookStopTest.js",
    "test:claude-hooks": "node dist/claudeHooksTest.js",
    "test:iterate": "node dist/iterateTest.js",
    "test:rename-diff": "node dist/renameDiffTest.js",
    "test:screens": "node dist/screenScopeTest.js",
    "test:twins": "node dist/twinCoverageTest.js",
    "test:repo-rules": "node dist/repoRulesTest.js",
    "test:preset": "node dist/presetDriftTest.js",
    "test:overrides": "node dist/overridesTest.js",
    "test:wiring": "node dist/wiringTest.js",
    "test:record": "node dist/recordTest.js",
    "test:snapshot": "node dist/snapshotTest.js",
    "test:time": "node dist/timeTest.js",
    "test:tasks": "node dist/tasksTest.js",
    "test:sibling-clone": "node dist/siblingCloneTest.js",
    "test:jsx-suppress": "node dist/jsxSuppressTest.js",
    "test:cli-args": "node dist/cliArgsTest.js",
    "test:rust-language": "node dist/rustLanguageTest.js",
    "test:rust-scan": "node dist/rustScanTest.js",
    "test:rust-config": "node dist/rustConfigTest.js",
    "test:schema-migration": "node dist/schemaMigrationTest.js",
    "test:rust-cli": "node dist/rustCliTest.js"
  },
  "dependencies": {
    "oxc-parser": "0.153.0",
    "smol-toml": "1.9.1",
    "ts-pattern": "^5.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.12.1",
  "publishConfig": {
    "access": "public"
  }
}
