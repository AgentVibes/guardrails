{
  "name": "@agentvibes/guardrails",
  "version": "0.1.0",
  "description": "Verification toolkit that makes agents write simple code: ast-grep rule canon, diff ratchet, biome/tsconfig presets, one CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentVibes/guardrails.git"
  },
  "type": "module",
  "bin": {
    "guardrails": "dist/cli.js"
  },
  "exports": {
    "./biome": "./configs/biome.json",
    "./tsconfig": "./configs/tsconfig.base.json",
    "./sgconfig": "./sgconfig.yml",
    "./package.json": "./package.json",
    "./plugin": "./dist/pluginApi.js"
  },
  "files": [
    "dist",
    "rules",
    "structure",
    "candidates",
    "configs",
    "sgconfig.yml",
    "mise.toml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:rules": "node dist/testRules.js",
    "test:gate": "node dist/gateRed.js",
    "check": "pnpm build && pnpm lint && pnpm test:rules && pnpm test:gate && pnpm test:metrics && pnpm test:init && pnpm test:severity && pnpm test:hooks && pnpm test:iterate && pnpm test:leaks && pnpm leaks",
    "test:metrics": "node dist/metricsCycle.js",
    "leaks": "node dist/cli.js leaks .",
    "test:leaks": "node dist/leaksRed.js",
    "test:init": "node dist/initTest.js",
    "test:severity": "node dist/severityTest.js",
    "test:hooks": "node dist/hookStopTest.js",
    "test:iterate": "node dist/iterateTest.js"
  },
  "dependencies": {
    "ts-pattern": "^5.6.2",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "publishConfig": {
    "access": "public"
  }
}
